{
  "name": "morivault-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform encrypted password vault built with Tauri, TypeScript, and pluggable cloud storage providers",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run build:web",
    "build:web": "tsc -p tsconfig.json && vite build",
    "tauri": "tauri",
    "dist": "npm run build:web && tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vite": "^6.2.6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0"
  }
}
